{
  "name": "yt-toolbar-master",
  "description": "A browser extension for YouTube (Chrome & Firefox)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:host": "node host/build.mjs",
    "test:host": "cd host && go vet ./... && go test ./...",
    "sign:firefox": "wxt build -b firefox && node scripts/sign-firefox.mjs",
    "release:dry": "node scripts/release.mjs --dry",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "preact": "^11.0.1"
  }
}
